{
	"name": "e-cidadania-bluesky-bot",
	"version": "0.1.0",
	"private": true,
	"description": "Posts every new e-Cidadania Consulta Pública to Bluesky",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"start": "node --env-file-if-exists=.env src/main.ts",
		"dry-run": "node --env-file-if-exists=.env src/main.ts --dry-run",
		"test": "node --test 'test/**/*.test.ts'",
		"typecheck": "tsc",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"dependencies": {
		"@atproto/api": "^0.30.3",
		"cheerio": "^1.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@types/node": "^24.19.2",
		"typescript": "^7.0.2"
	}
}
